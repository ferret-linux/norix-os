// ============================================================================
// NOCTALIA LAYER RULES
// ============================================================================

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
        // blur false
    }
}


// ============================================================================
// LAUNCHER WINDOWS (floating, small)
// ============================================================================

window-rule {
    match app-id="steam"
    match app-id="lutris"
    match app-id="com.usebottles.bottles"
    match app-id="goverlay"

    open-floating          true
    default-column-width   { proportion 0.55; }
    default-window-height  { proportion 0.70; }
}


// ============================================================================
// STEAM SUB-WINDOWS
// ============================================================================

// Steam's friends list, chat, and small popups shouldn't tile —
// they're meant to float freely alongside a game.
window-rule {
    match app-id="steam" title="^Friends List$"
    match app-id="steam" title="^Steam - News$"
    open-floating true
}

// The Steam Big Picture / game overlay should always be fullscreen.
window-rule {
    match app-id="steam" title="^Steam Big Picture Mode$"
    open-fullscreen true
}


// ============================================================================
// GAME WINDOWS (gamescope / Proton / Wine)
// ============================================================================

// gamescope sessions should always claim the whole output.
window-rule {
    match app-id="gamescope"
    open-fullscreen true
}

// ============================================================================
// PERFORMANCE
// ============================================================================

// Skip xray/background-blur compositing on any game window — pure
// overhead with no benefit once a game has focus.
window-rule {
    match app-id="gamescope"
    match title="^.*\.exe$"

    background-effect {
        xray true
        blur false
    }
}


// ============================================================================
// EDITOR / IDE WINDOWS
// ============================================================================

// VS Code's picker/quick-open popups shouldn't tile — they're
// meant to float briefly over the main window.
window-rule {
    match app-id="code" title="^Quick Open$"
    open-floating true
}


// ============================================================================
// CONTAINERS / VIRTUALIZATION TOOLING
// ============================================================================

window-rule {
    match app-id="io.github.marhkb.Pods"

    open-floating          true
    default-column-width   { proportion 0.55; }
    default-window-height  { proportion 0.70; }
}


// ============================================================================
// VM MANAGER WINDOWS
// ============================================================================

window-rule {
    match app-id="virt-manager"
    match app-id="org.gnome.Boxes"

    open-floating          true
    default-column-width   { proportion 0.55; }
    default-window-height  { proportion 0.65; }
}


// ============================================================================
// VM CONSOLE / DISPLAY WINDOWS
// ============================================================================

// virt-viewer consoles should float and default to a size close to
// a typical guest resolution rather than being forced into a tile.
window-rule {
    match app-id="virt-viewer"

    open-floating          true
    default-column-width   { proportion 0.70; }
    default-window-height  { proportion 0.75; }
}

// Once a console window has keyboard/mouse grabbed by the guest OS,
// don't let background-effect compositing chew through frames —
// same reasoning as gx's game-window rule.
window-rule {
    match app-id="virt-viewer"

    background-effect {
        xray true
        blur false
    }
}


// ============================================================================
// GLOBAL WINDOW APPEARANCE
// ============================================================================

window-rule {
    geometry-corner-radius       8
    clip-to-geometry             true
    draw-border-with-background  false
}

// Generic windows: no xray cutout, keep blur enabled.
window-rule {
    background-effect {
        xray false
        blur true
    }
}


// ============================================================================
// FLOATING WINDOW RULES
// ============================================================================

// --- Small utility windows ---
window-rule {
    match app-id="org.gnome.Characters"
    match app-id="kbd-layout-viewer"
    match app-id="org.gnome.FileRoller"
    match app-id="gnome-disks"
    match app-id="org.gnome.seahorse.Application"
    match app-id="zync.updater.ghostty.window"

    open-floating          true
    default-column-width   { proportion 0.45; }
    default-window-height  { proportion 0.45; }
}

// --- Android / GPU settings ---
window-rule {
    match app-id="Waydroid"
    match app-id="nvidia-settings"

    open-floating          true
    default-column-width   { proportion 0.35; }
    default-window-height  { proportion 0.25; }
}

// --- Printer configuration ---
window-rule {
    match app-id="system-config-printer"

    open-floating          true
    default-column-width   { proportion 0.30; }
    default-window-height  { proportion 0.30; }
}

// --- File managers / theming tools ---
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="nwg-look"

    open-floating          true
    default-column-width   { proportion 0.45; }
    default-window-height  { proportion 0.50; }
}

// --- Noctalia settings window ---
window-rule {
    match app-id="dev.noctalia.Noctalia"

    open-floating          true
    default-column-width   { proportion 0.55; }
    default-window-height  { proportion 0.65; }
}